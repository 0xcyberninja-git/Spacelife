                desc: "Raw Martian regolith lacks organic carbon and nitrogen and is contaminated with thyroid-disrupting perchlorate salts ($ClO_4^-$). Primary physical particles are abrasive and nutrient-deficient."
            },
            2: {
                title: "Stage 2: Bacterial Inoculation & Bioremediation",
                agent: "Azospira oryzae & Dehalococcoides mccartyi",
                mechanism: "Perchlorate Reductase Enzymatic Cascade",
                desc: "Inoculating moist regolith with extremophilic perchlorate-reducing bacteria anaerobically reduces $ClO_4^-$ into harmless chloride ($Cl^-$) ions while liberating free oxygen gas ($O_2$)."
            },
            3: {
                title: "Stage 3: SCWO Biosolid Mineralization & Enrichment",
                condition: "374°C & 22.1 MPa (Supercritical Water Phase)",
                benefit: "100% Pathogen Destruction + Inorganic Salt Precipitation",
                desc: "Human feces and crop residues are processed in Supercritical Water Oxidation (SCWO) reactors. Organic carbon converts instantly to $CO_2$ and $H_2O$, while insoluble phosphorus and potassium precipitate out as sterile plant nutrients."
            },
            4: {
                title: "Stage 4: Rhizosphere Organic Acid & Mycorrhizal Mobilization",
                symbiosis: "Arbuscular Mycorrhizal Fungi (AMF) + Organic Exudates",
                result: "Arable, Bio-Active Extraterrestrial Soil Matrix",
                desc: "Plant roots secrete malic and citric acids, lowering local soil pH and solubilizing trapped minerals. Fungal hyphae networks expand root surface area by 400%, facilitating nutrient uptake."
            }
        };

        // --- MASS BALANCE CALCULATOR LOGIC ---
        function updateCalculator() {
            const crew = parseInt(document.getElementById('crew-count').value);
            const days = parseInt(document.getElementById('mission-days').value);

            document.getElementById('crew-val').innerText = `${crew} Crew`;
            document.getElementById('days-val').innerText = `${days} Days`;

            // Baseline constants (kg/person/day)
            const o2PerDay = 0.865;
            const h2oPerDay = 2.92;
            const foodPerDay = 0.71;
            const co2PerDay = 1.04;

            const totalO2 = Math.round(crew * days * o2PerDay);
            const totalH2O = Math.round(crew * days * h2oPerDay);
            const totalFood = Math.round(crew * days * foodPerDay);
            const totalCO2 = Math.round(crew * days * co2PerDay);

            document.getElementById('out-o2').innerText = `${totalO2.toLocaleString()} kg`;
            document.getElementById('out-h2o').innerText = `${totalH2O.toLocaleString()} kg`;
            document.getElementById('out-food').innerText = `${totalFood.toLocaleString()} kg`;
            document.getElementById('out-co2').innerText = `${totalCO2.toLocaleString()} kg`;
        }

        document.getElementById('crew-count').addEventListener('input', updateCalculator);
        document.getElementById('mission-days').addEventListener('input', updateCalculator);

        // --- MELISSA COMPARTMENT SELECTOR ---
        function showMelissa(id) {
            // Update active styling
            for (let i = 1; i <= 5; i++) {
                const btn = document.getElementById(`mel-btn-${i}`);
                if (i === id) {
                    btn.className = "mel-node p-3 rounded-xl border-2 border-bio-500 bg-bio-50 text-left transition hover:shadow-md";
                } else {
                    btn.className = "mel-node p-3 rounded-xl border border-slate-200 bg-slate-50 text-left transition hover:shadow-md";
                }
            }

            const data = melissaData[id];
            const detailContainer = document.getElementById('melissa-detail');
            detailContainer.innerHTML = `
                <div class="flex justify-between items-center border-b border-slate-800 pb-2">
                    <h4 class="text-lg font-bold text-bio-300">${data.title}</h4>
                    <span class="bg-bio-900/80 text-bio-200 border border-bio-600 px-2.5 py-0.5 rounded text-xs">${data.type}</span>
                </div>
                <p class="text-xs text-slate-300 leading-relaxed">${data.desc}</p>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-xs pt-2">
                    <div class="bg-space-950 p-2.5 rounded border border-slate-800">
                        <span class="text-slate-400 block text-[10px] uppercase">Target Organism</span>
                        <span class="font-semibold text-white">${data.agent}</span>
                    </div>
                    <div class="bg-space-950 p-2.5 rounded border border-slate-800">
                        <span class="text-slate-400 block text-[10px] uppercase">Temperature</span>
                        <span class="font-semibold text-amber-300">${data.temp}</span>
                    </div>
                    <div class="bg-space-950 p-2.5 rounded border border-slate-800">
                        <span class="text-slate-400 block text-[10px] uppercase">Primary Inputs</span>
                        <span class="font-semibold text-cyan-300">${data.inputs}</span>
                    </div>
                    <div class="bg-space-950 p-2.5 rounded border border-slate-800">
                        <span class="text-slate-400 block text-[10px] uppercase">Primary Outputs</span>
                        <span class="font-semibold text-bio-300">${data.outputs}</span>
                    </div>
                </div>
            `;
        }

        // --- CROP MATRIX FILTER ---
        function renderCrops(category = 'all') {
            const grid = document.getElementById('crop-grid');
            grid.innerHTML = '';

            const filtered = category === 'all' ? cropData : cropData.filter(c => c.cat === category);

            filtered.forEach(crop => {
                const card = document.createElement('div');
                card.className = "bg-space-50 p-4 rounded-xl border border-slate-200 hover:border-bio-400 transition space-y-2";
                card.innerHTML = `
                    <div class="flex justify-between items-start">
                        <h4 class="font-bold text-space-900 text-sm">${crop.name}</h4>
                        <span class="text-[10px] uppercase font-bold px-2 py-0.5 rounded bg-bio-100 text-bio-800">${crop.cat}</span>
                    </div>
                    <p class="text-xs text-slate-600 leading-relaxed">${crop.desc}</p>
                    <div class="grid grid-cols-2 gap-2 text-[11px] pt-2 border-t border-slate-200/80">
                        <div><span class="text-slate-400">Harvest:</span> <strong class="text-slate-800">${crop.harvest}</strong></div>
                        <div><span class="text-slate-400">Protein:</span> <strong class="text-bio-700">${crop.protein}</strong></div>
                        <div><span class="text-slate-400">Light Demand:</span> <strong class="text-slate-800">${crop.light}</strong></div>
                        <div><span class="text-slate-400">ESM Impact:</span> <strong class="text-amber-700">${crop.esm}</strong></div>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function filterCrops(cat) {
            const btns = document.querySelectorAll('.crop-filter-btn');
            btns.forEach(b => {
                b.className = "crop-filter-btn px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200";
            });
            event.target.className = "crop-filter-btn px-3 py-1.5 rounded-lg bg-bio-600 text-white";
            renderCrops(cat);
        }

        // --- SOIL STAGE SELECTOR ---
        function showSoilStage(stageId) {
            for (let i = 1; i <= 4; i++) {
                const tab = document.getElementById(`soil-tab-${i}`);
                if (i === stageId) {
                    tab.className = "p-3 text-xs font-bold rounded-lg border-2 border-amber-500 bg-amber-50 text-amber-900";
                } else {
                    tab.className = "p-3 text-xs font-bold rounded-lg border border-slate-200 bg-slate-50 text-slate-600";
                }
            }

            const stage = soilStages[stageId];
            const detailContainer = document.getElementById('soil-stage-detail');
            
            let extraMeta = '';
            if (stageId === 1) extraMeta = `<div class="text-xs text-amber-300"><strong>Primary Hazard:</strong> ${stage.hazard} | <strong>pH Level:</strong> ${stage.pH}</div>`;
            if (stageId === 2) extraMeta = `<div class="text-xs text-bio-300"><strong>Inoculant Strain:</strong> ${stage.agent} | <strong>Mechanism:</strong> ${stage.mechanism}</div>`;
            if (stageId === 3) extraMeta = `<div class="text-xs text-cyan-300"><strong>SCWO State:</strong> ${stage.condition} | <strong>Benefit:</strong> ${stage.benefit}</div>`;
            if (stageId === 4) extraMeta = `<div class="text-xs text-purple-300"><strong>Bio-Symbiosis:</strong> ${stage.symbiosis} | <strong>Outcome:</strong> ${stage.result}</div>`;

            detailContainer.innerHTML = `
                <h4 class="text-base font-bold text-amber-300">${stage.title}</h4>
                ${extraMeta}
                <p class="text-xs text-slate-300 leading-relaxed pt-2 border-t border-slate-800">${stage.desc}</p>
            `;
        }

        // --- CHART INITIALIZATIONS (CHART.JS) ---
        function initCharts() {
            // Chart 1: ESM Trade-off Line Chart
            const ctxEsm = document.getElementById('esmChart').getContext('2d');
            new Chart(ctxEsm, {
                type: 'line',
                data: {
                    labels: ['0 Yrs', '1 Yr', '2 Yrs', '3 Yrs', '4 Yrs', '4.8 Yrs (Crossover)', '6 Yrs', '8 Yrs'],
                    datasets: [
                        {
                            label: 'Physicochemical Resupply ESM (kg)',
                            data: [1500, 4700, 7900, 11100, 14300, 16860, 20700, 27100],
                            borderColor: '#ef4444',
                            backgroundColor: 'rgba(239, 68, 68, 0.1)',
                            borderWidth: 2,
                            tension: 0.1,
                            fill: false
                        },
                        {
                            label: 'Bioregenerative Life Support (BLSS) ESM (kg)',
                            data: [14000, 14600, 15200, 15800, 16400, 16860, 17600, 18800],
                            borderColor: '#16a34a',
                            backgroundColor: 'rgba(22, 163, 74, 0.1)',
                            borderWidth: 3,
                            tension: 0.1,
                            fill: false
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top', labels: { boxWidth: 12, font: { size: 11 } } },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return `${context.dataset.label}: ${context.parsed.y.toLocaleString()} kg`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: { grid: { display: false }, ticks: { font: { size: 10 } } },
                        y: { 
                            title: { display: true, text: 'ESM Mass Penalty (kg)', font: { size: 11 } },
                            ticks: { font: { size: 10 } }
                        }
                    }
                }
            });

            // Chart 2: Lighting PPE Bar Chart
            const ctxPpe = document.getElementById('ppeChart').getContext('2d');
            new Chart(ctxPpe, {
                type: 'bar',
                data: {
                    labels: ['Early Commercial LED', 'Standard ISS Veggie', 'High-Efficiency Target', 'Himawari Fiber Solar'],
                    datasets: [{
                        label: 'Photosynthetic Photon Efficacy (µmol / Joule)',
                        data: [1.8, 2.1, 3.2, 4.5],
                        backgroundColor: ['#94a3b8', '#38bdf8', '#22c55e', '#f59e0b'],
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return `PPE: ${context.parsed.y} µmol/J`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: { grid: { display: false }, ticks: { font: { size: 10 } } },
                        y: { 
                            title: { display: true, text: 'Photon Efficacy (µmol/J)', font: { size: 11 } },
                            ticks: { font: { size: 10 } },
                            beginAtZero: true
                        }
                    }
                }
            });
        }

        // --- ON LOAD INITIALIZATION ---
        window.addEventListener('DOMContentLoaded', () => {
            updateCalculator();
            showMelissa(1);
            renderCrops('all');
            showSoilStage(1);
            initCharts();
        });
    </script>

